{
  "description": "Appends a TL;DR under every long reply, on the message's final display chunk.",
  "hooks": {
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/tldr-hook",
            "args": [],
            "timeout": 130,
            "statusMessage": "Writing the TL;DR"
          }
        ]
      }
    ]
  }
}
